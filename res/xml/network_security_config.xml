<?xml version='1.0' encoding='utf-8'?>
<!-- HTTPS-only traffic to the ClassPay API. Base-config disallows cleartext. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config includeSubdomains="true">
        <domain>classpay.padat.net</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
